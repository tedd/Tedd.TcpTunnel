{
  "Forwards": [
    {
      "Name": "web",
      "Mode": "Raw",
      "ListenAddress": "127.0.0.1",
      "ListenPort": 8080,
      "RemoteHost": "127.0.0.1",
      "RemotePort": 80,
      "Encryption": { "Algorithm": "None" },
      "ListenTls": { "Mode": "None" },
      "RemoteTls": { "Mode": "None" },
      "BufferSize": 65536,
      "BatchMilliseconds": 0,
      "Execution": "Async",
      "Retry": { "Attempts": 3 },
      "Socket": { "NoDelay": true, "KeepAlive": true, "DualMode": true },
      "AccessControl": {
        "Allow": ["127.0.0.0/8", "::1"],
        "Deny": []
      }
    }
  ],
  "Update": {
    "CheckOnStartup": true,
    "CheckIntervalHours": 24,
    "Repository": "tedd/Tedd.TcpTunnel",
    "IncludePrerelease": false,
    "InstallKind": "auto"
  },
  "Logging": {
    "Level": "Information",
    "Console": true,
    "File": null
  }
}
