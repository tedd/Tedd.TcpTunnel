<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
    <OutputType>Bundle</OutputType>
    <PackageVersion Condition="'$(PackageVersion)' == ''">2.0.0</PackageVersion>
    <MsiPath Condition="'$(MsiPath)' == ''">$(MSBuildThisFileDirectory)..\Package\bin\$(Configuration)\tcptunnel-$(PackageVersion)-win-$(InstallerPlatform).msi</MsiPath>
    <DefineConstants>PackageVersion=$(PackageVersion);MsiPath=$(MsiPath)</DefineConstants>
    <OutputName>tcptunnel-$(PackageVersion)-win-$(InstallerPlatform)-setup</OutputName>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="WixToolset.Bal.wixext" Version="5.0.2" /></ItemGroup>
</Project>

